# ==============================================================================
# AURASeg .gitignore
# ==============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg

# Virtual Environment
.venv/
venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/

# ==============================================================================
# DATASETS - Exclude (too large)
# ==============================================================================
carl-dataset/
CommonDataset/
CommonDataset.zip
GAZEBO/

# External repos (have their own git)
GMRPD/

# ==============================================================================
# CHECKPOINTS & BINARY EXPORTS - Exclude (>50MB each)
# ==============================================================================
*.pth
*.pt
*.onnx
*.onnx.data
*.data
*.engine
*.zip
*.log
runs/deployment/onnx/
runs/deployment/tensorrt/
runs/deployment/*.onnx*
runs/deployment/*.engine*

# Temporary/debug files to exclude
debug_cuda.py
test_fcn.py
param_report.txt
paper.pdf
patch_*.py
rewrite_*.py

# OS files
.DS_Store
Thumbs.db
desktop.ini

# The reorganized folder (we're using actual structure)
github_repo/

# Visualization outputs (can regenerate)
visualization-val/
